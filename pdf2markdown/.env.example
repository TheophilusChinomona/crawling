# Copy to .env and fill in your key. Do not commit .env.
# Get a Gemini API key: https://aistudio.google.com/app/apikey
# The script auto-discovers models for your key; use any supported name (e.g. gemini-2.0-flash).
# If the model is invalid, the script will print example models you can use.

GEMINI_API_KEY=
PDF2MD_MODEL=gemini-2.0-flash

# Optional: local OCR (Tesseract). Requires Tesseract installed; set TESSDATA_PREFIX if needed.
# PDF2MD_OCR_LANG=eng
# TESSDATA_PREFIX=C:/Program Files/Tesseract-OCR/tessdata
